# Copy to `.env` and adjust. docker-compose reads this automatically.
#
# Shared secret authenticating lark-edge ↔ lark-server. The value below is the
# publicly-known placeholder and is REJECTED at startup outside local dev — both
# lark-edge and lark-server refuse to boot with it. Generate a real one with:
#
#   openssl rand -hex 32
#
# `make up` does this for you automatically (it writes a fresh .env with a random
# secret if none exists), so you only need this file when running `docker compose`
# directly or pinning a specific secret.
SERVER_SECRET=dev-secret-change-me
