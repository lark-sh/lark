# Copy to `.env` and adjust. docker-compose reads this automatically.
#
# Shared secret authenticating lark-edge ↔ lark-server. The compose default is
# "dev-secret-change-me" — fine for local dev, but set a real value for anything
# reachable by others. Generate one with:  openssl rand -hex 32
SERVER_SECRET=dev-secret-change-me
